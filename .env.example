# 로컬은 언제나 **dev** 프로젝트(xiwwbgltkbvxdzxxxoba)다. prod 값은 Vercel Production env에만 둔다 —
# 로컬에서 prod에 붙는 경로를 만들지 않는다(Week 68 환경 분리, CLAUDE.md 「환경」).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 배포 도메인 (OG/SEO 메타데이터용). 로컬은 비워도 됨
NEXT_PUBLIC_SITE_URL=
# AI 코칭 사용 시에만 (이번 배포 제외)
# ANTHROPIC_API_KEY=

# ── 스크립트 전용(앱 코드는 읽지 않는다) ──
# scripts/db-history.ts — 대시보드 [Connect] › Session pooler URI. dev는 DATABASE_URL, prod 재생·스냅샷은 SUPABASE_PROD_DB_URL(Direct URI 그대로 — 스크립트가 pooler로 변환)
# DATABASE_URL=
# SUPABASE_PROD_DB_URL=
# scripts/backfill-personal-ntrp.ts — service role(RLS 우회). 어느 프로젝트에 붙는지는 NEXT_PUBLIC_SUPABASE_URL이 정한다
# SUPABASE_SERVICE_ROLE_KEY=
