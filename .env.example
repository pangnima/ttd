# ─────────────────────────────────────────────────────────────────────────────
# 이 파일은 "어떤 값이 필요한지"를 보여주는 예시입니다. 값은 비어 있습니다.
#   1) 이 파일을 복사해 .env.local 을 만든다   (cp .env.example .env.local)
#   2) 아래 안내대로 값을 채운다
#   .env.local 은 git에 올라가지 않습니다(.gitignore). 비밀값은 여기가 아니라 .env.local에만 둡니다.
#
# 로컬(.env.local)은 언제나 **테스트 서버(dev, TennisClubs)** 값입니다.
# 실서비스(prod, baselineplay-prod) 값은 Vercel 대시보드의 Production 환경변수에만 넣습니다 —
# 로컬에서 실서비스 DB에 붙는 길을 만들지 않기 위해서입니다.
#
# 이름이 NEXT_PUBLIC_ 로 시작하는 값은 브라우저(사용자 PC)까지 그대로 전달됩니다 → 공개해도 되는 값만.
# ─────────────────────────────────────────────────────────────────────────────

# [필수] Supabase 프로젝트 주소
#   무엇: 앱이 붙을 DB·로그인 서버의 주소
#   어디서: Supabase 대시보드 → 프로젝트(TennisClubs) → Project Settings → API → Project URL
#   공개 여부: 공개 (브라우저에 노출됨)
NEXT_PUBLIC_SUPABASE_URL=

# [필수] Supabase anon 키
#   무엇: 로그인 전 사용자(anon)가 쓰는 공개 키. 실제 접근 제어는 DB의 RLS 정책이 한다
#   어디서: 같은 화면 → API Keys → "anon" "public" 키 (eyJ… 로 시작)
#   공개 여부: 공개 (브라우저에 노출됨 — "service_role" 키와 헷갈리지 말 것, 그건 절대 여기 넣지 않는다)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [선택] 배포 도메인
#   무엇: 링크 미리보기(OG 이미지)·SEO 메타에 쓰는 절대 주소. 로그인 리다이렉트는 요청 주소를 우선 쓴다
#   어디서: 배포 주소 그대로 (https://baselineplay.vercel.app). 로컬은 비워도 됨
#   공개 여부: 공개
NEXT_PUBLIC_SITE_URL=

# ───── 아래는 앱이 아니라 scripts/ 의 도구 스크립트만 읽는 값 — 평소 개발에는 필요 없음 ─────

# [선택] 테스트 서버 DB 직접 연결 문자열 — scripts/db-history.ts (마이그레이션 히스토리 내려받기·비교)
#   어디서: Supabase 대시보드 → 상단 [Connect] → Direct connection URI 를 복사해 [YOUR-PASSWORD] 자리를 채운다
#           (DB 비밀번호는 GitHub 비밀번호가 아니다. 모르면 Project Settings → Database → Reset database password)
#   공개 여부: 비밀 (DB 전체 권한). 채팅·이슈에 붙이지 말 것
# DATABASE_URL=

# [선택] 실서비스 DB 직접 연결 문자열 — 새 환경 재생·스키마 비교에만 쓴다. 평소에는 비워 둔다
#   공개 여부: 비밀
# SUPABASE_PROD_DB_URL=

# [선택] 위 두 연결이 실패할 때만 — 스크립트가 Direct URI를 pooler 주소로 바꿔 붙는데,
#   pooler 클러스터 번호가 프로젝트마다 다르다(dev aws-1 · prod aws-0). 기본값이 안 맞으면 지정
# SUPABASE_POOLER_HOST=aws-0-ap-northeast-2.pooler.supabase.com
# SUPABASE_REGION=ap-northeast-2

# [선택] service_role 키 — scripts/backfill-personal-ntrp.ts (RLS를 우회하는 일회성 백필)에만
#   어디서: Project Settings → API Keys → service_role
#   공개 여부: 비밀 (모든 데이터 읽기·쓰기 가능). 앱 코드는 이 값을 절대 읽지 않는다
# SUPABASE_SERVICE_ROLE_KEY=
